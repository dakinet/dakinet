	(text "IAMP = 5,02 x I x 1 Ohm   (pojacanje 1 + R22/R21 = 1 + 40k2/10k)\nBIT = 1 kad IAMP > PRAG_F (PWM sa GP16, filtar R23/C22) -> prijem strujnog odgovora uredjaja\nOCP = 1 kad IAMP > OC_REF = 3,3 x 10k/23k = 1,435 V  ->  I > ~285 mA\nD4 + R27 vracaju OCP na OC_IN -> zadrska (latch) dok MCU ne posalje OC_RST (Q7)\nOCP -> Q6 hardverski gasi VSET (petlju) i javlja se MCU na GP6"
		(exclude_from_sim no)
		(at 314.96 320.04 0)
		(effects
			(font
				(size 1.1 1.1))
			(justify left top))
		(uuid "65fc519f-316a-4543-8d50-04cd89f3596f"))
	(text "napajanje U4, blokada:\nC20 (U4), C21 (U5), C23 (U6)"
		(exclude_from_sim no)
		(at 508 248.92 0)
		(effects
			(font
				(size 1.1 1.1))
			(justify left top))
		(uuid "cdcca5ae-6591-483c-b15b-b28281cf4f64"))
	(text "U4B se ne koristi:\nsledilac, + na masi"
